# Quiver environment configuration
# Copy this file to .env and set values for your machine.
# .env is gitignored — never commit it.

# ──────────────────────────────────────────────
# WORDLISTS_PATH
# Path on your HOST machine to a wordlists directory.
# This gets bind-mounted into the container at /wordlists.
#
# If not set, Quiver uses ./data/wordlists/ (drop .txt files there).
#
# macOS — SecLists via Homebrew:
# WORDLISTS_PATH=/usr/share/seclists
#
# Linux — SecLists system install:
# WORDLISTS_PATH=/usr/share/seclists
#
# Linux — Kali default:
# WORDLISTS_PATH=/usr/share/wordlists
#
# Windows (WSL2) — SecLists cloned to home dir:
# WORDLISTS_PATH=/mnt/c/Users/yourname/SecLists
#
# Custom location (any OS):
# WORDLISTS_PATH=/path/to/your/wordlists
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# AI PROVIDER SETTINGS
#
# You need one of the two Claude options below to use the Claude provider
# in campaigns. Set only one — if both are set, CLAUDE_CODE_OAUTH_TOKEN wins.
#
# ── Option A: OAuth token (Claude Pro or Team subscription) ────────────────
# Generate with: claude setup-token
# This routes through the claude-bridge sidecar (Claude Code CLI).
# No per-token API cost — uses your existing subscription.
#
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#
# ── Option B: Standard API key (pay-per-token) ────────────────────────────
# From console.anthropic.com → API Keys
# Calls the Anthropic Messages API directly.
#
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# ── Claude model ──────────────────────────────────────────────────────────
# Which Claude model to use. Haiku is fast; upgrade for harder targets.
# claude-haiku-4-5-20251001  (default — fast, cost-effective)
# claude-sonnet-5            (more capable, slower)
#
# CLAUDE_MODEL=claude-haiku-4-5-20251001
#
# ── Local AI model ────────────────────────────────────────────────────────
# Local model to pull and use. qwen2.5:7b is the default.
# Larger models (14b, 32b) need more RAM but produce better results.
#
# OLLAMA_MODEL=qwen2.5:7b
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# SHANNON INTEGRATION (Web App Scanning)
#
# Shannon is the web application pentesting engine — 19 parallel specialized
# vulnerability agents, Playwright-based authentication, TOTP/2FA support.
#
# No extra API keys needed — Shannon reuses CLAUDE_CODE_OAUTH_TOKEN or
# ANTHROPIC_API_KEY from above.
#
# SHANNON_HOST_DIR — REQUIRED for Shannon to work correctly.
# Set this to the absolute HOST path of the pentest-platform/shannon/ directory.
# Shannon's web server passes this to `docker run -v` when spawning worker
# containers so they can write scan output to the workspaces/ folder.
#
# Example (macOS):
# SHANNON_HOST_DIR=/Users/yourname/pentest-platform/shannon
#
# Example (Linux):
# SHANNON_HOST_DIR=/opt/quiver/shannon
#
# SHANNON_HOST_DIR=/absolute/path/to/pentest-platform/shannon
#
# ── Advanced Shannon settings (defaults are fine for most users) ─────────────
# SHANNON_JWT_SECRET=quiver-shannon-jwt-secret-changeme
# SHANNON_ENCRYPTION_KEY=quiver-shannon-enc-key32-changeme!
# SHANNON_DB_PASSWORD=shannon_db_pass
# SHANNON_ADMIN_EMAIL=admin@localhost
# SHANNON_ADMIN_PASSWORD=admin
# ──────────────────────────────────────────────
